// KicksDB (https://kicks.dev) — datos reales de StockX/GOAT
KICKSDB_API_KEY =
// eBay Browse API (precios de listados Authenticity Guaranteed). Pon los valores reales en
// DeveloperSettings.local.xcconfig (no versionado). App ID = Client ID, Cert ID = Client Secret.
EBAY_CLIENT_ID =
EBAY_CLIENT_SECRET =
// Modelo Image API para «Prettify» del clóset (dejar vacío = gpt-image-1 por código)
OPENAI_CLOSET_IMAGE_MODEL = gpt-image-1
OPENAI_CLOSET_IMAGE_QUALITY = medium
OPENAI_CLOSET_IMAGE_SIZE = 1024x1024
// Commercial GOAT / Alias proxy (CommercialGoatAPI). Request trial token from provider.
GOAT_API_TOKEN =
GOAT_API_BASE_URL = https://goatapi.dataspiderhub.com
// Mapeo columnas INSERT en `vehicles` (vacío = defaults en código; ver VehiclesInsertColumnMap).
VEHICLES_COL_ID =
VEHICLES_COL_USER_ID =
VEHICLES_COL_ORGANIZATION_ID =
VEHICLES_COL_COMPANY_ID =
VEHICLES_COL_BRAND =
VEHICLES_COL_MODEL =
VEHICLES_COL_YEAR =
VEHICLES_COL_LICENSE_PLATE =
