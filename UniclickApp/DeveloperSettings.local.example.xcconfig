// 1) Duplica este archivo y renómbralo a: DeveloperSettings.local.xcconfig
// 2) Esa copia NO se sube a git (ya está en .gitignore).
// 3) Pega tu clave real solo en .local, nunca en este .example.

// Clóset local — Gemini desde el dispositivo (opcional si usas pestaña Closet)
// Formato válido (ejemplo abreviado): AIza...   ← solo ese texto después del igual
// Incorrecto: rutas como UniclickApp/DeveloperSettings.xcconfig (Gemini responderá API_KEY_INVALID)
// GEMINI_API_KEY =
// --- OpenAI ---
// Opcional: si defines OPENAI_API_KEY aquí (sk-proj-…), «Prettify» del clóset usa Images API y NO Gemini para la foto profesional.
// Nunca pegues tu clave real en el .example ni en git; sólo en DeveloperSettings.local.xcconfig.
OPENAI_API_KEY = sk-proj-TU_CLAVE_AQUI
// Modelo multimodal recomendado: gpt-image-1 · Si tu cuenta lo permite prueba gpt-image-2
OPENAI_CLOSET_IMAGE_MODEL = gpt-image-1
// Calidad edits gpt-image-1: low | medium | high (medium ≈ $0.042 / 1024 según tabla OpenAI).
OPENAI_CLOSET_IMAGE_QUALITY = medium
OPENAI_CLOSET_IMAGE_SIZE = 1024x1024
// Las credenciales de KicksDB/eBay NO van en este archivo ni en el bundle iOS.
// Se configuran como secrets de Supabase para la función `marketplace-gateway`;
// consulta `supabase/MARKETPLACE_GATEWAY.md`.
// Recomendado visión (foto del vehículo): gpt-4o · Barato: gpt-4o-mini
// OPENAI_MODEL = gpt-4o

// Generador de contratos (pantalla Contratos IA) — sigue usando Claude si lo configuras
// ANTHROPIC_API_KEY = sk-ant-api03-TU_CLAVE_AQUI
// ANTHROPIC_MODEL = claude-sonnet-4-20250514

// --- Columnas INSERT en `vehicles` (opcional). Por defecto la app usa: ---
// make, model, year, license_plate, price, kilometers, fuel, transmission.
// Ejemplo si tu tabla usa español:
// VEHICLES_COL_BRAND = marca
// VEHICLES_COL_MODEL = modelo
// VEHICLES_COL_MILEAGE = kilometraje
// VEHICLES_COL_FUEL_TYPE = combustible
// URL de portada tras subir fotos (por defecto main_image_url):
// VEHICLES_COL_MAIN_IMAGE_URL = image_url
